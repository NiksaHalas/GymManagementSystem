# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (password reset redirect: {SITE_URL}/auth/callback?next=/reset)
# Also add {SITE_URL}/auth/callback to Supabase Auth → Redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — deploy only: push Auth redirect URLs + OTP expiry via npm run auth:push-config
# SUPABASE_ACCESS_TOKEN=your_personal_access_token

# Shift attribution badge cutoff (ISO timestamp). Defaults to migration launch if unset.
# SHIFT_ATTRIBUTION_LAUNCH_AT=2026-06-17T10:07:00.000Z

# Counter device HMAC secret (generate a random 32+ char string)
COUNTER_DEVICE_SECRET=change-me-to-a-long-random-secret

# Offline PWA + outbox (Phase 3). Set true on the counter device only.
NEXT_PUBLIC_OFFLINE_ENABLED=false

# Resend (password reset emails only)
# Get API key: https://resend.com/api-keys
# Sandbox: onboarding@resend.dev only delivers to the email on your Resend account.
# For real inboxes, verify a domain and set RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
