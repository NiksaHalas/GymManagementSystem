# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Supabase service-role key — NEVER expose in the browser or commit to git
# Used by: scripts/seed-admins.mjs, utils/supabase/admin.ts (server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Resend (email / password reset) ─────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "From" address for outgoing emails. Must be a verified domain in Resend.
# Defaults to onboarding@resend.dev for local testing (limited to 1 email/day).
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Counter device ───────────────────────────────────────────────────────────
# Secret used to sign the gym_counter cookie (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret and rotate it if the counter device is compromised.
COUNTER_DEVICE_SECRET=<64-hex-chars>

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used as the redirectTo base for password-reset links.
# In production: your Vercel deployment URL (e.g. https://gym.example.com)
# In development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
